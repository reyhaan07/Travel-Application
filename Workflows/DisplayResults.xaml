<Activity mc:Ignorable="sap sap2010" x:Class="DisplayResults" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation" xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib" xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib" xmlns:sd="clr-namespace:System.Data;assembly=System.Data.Common" xmlns:ui="http://schemas.uipath.com/workflow/activities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_RunMode" Type="InArgument(x:String)" />
    <x:Property Name="in_Source" Type="InArgument(x:String)" />
    <x:Property Name="in_Destination" Type="InArgument(x:String)" />
    <x:Property Name="in_TravelDate" Type="InArgument(x:String)" />
    <x:Property Name="in_FlightFound" Type="InArgument(x:Boolean)" />
    <x:Property Name="in_FlightRow" Type="InArgument(sd:DataRow)" />
    <x:Property Name="in_TrainFound" Type="InArgument(x:Boolean)" />
    <x:Property Name="in_TrainRow" Type="InArgument(sd:DataRow)" />
    <x:Property Name="in_CheaperMode" Type="InArgument(x:String)" />
    <x:Property Name="in_CheaperService" Type="InArgument(x:String)" />
    <x:Property Name="in_CheaperFare" Type="InArgument(x:Double)" />
    <x:Property Name="in_PriceDifference" Type="InArgument(x:Double)" />
    <x:Property Name="in_ComparisonMessage" Type="InArgument(x:String)" />
  </x:Members>
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System.Activities</x:String>
      <x:String>System.Activities.Statements</x:String>
      <x:String>System.Activities.Expressions</x:String>
      <x:String>System.Activities.Validation</x:String>
      <x:String>System.Activities.XamlIntegration</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
      <x:String>Microsoft.VisualBasic.Activities</x:String>
      <x:String>System</x:String>
      <x:String>System.Collections</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Data</x:String>
      <x:String>System.Linq</x:String>
      <x:String>System.Xml</x:String>
      <x:String>System.Text</x:String>
      <x:String>System.Xml.Linq</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
      <x:String>System.Collections.ObjectModel</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>mscorlib</AssemblyReference>
      <AssemblyReference>System.Private.CoreLib</AssemblyReference>
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>System.Data</AssemblyReference>
      <AssemblyReference>System.Data.Common</AssemblyReference>
      <AssemblyReference>System.Xml</AssemblyReference>
      <AssemblyReference>System.Xml.Linq</AssemblyReference>
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>Microsoft.CSharp</AssemblyReference>
      <AssemblyReference>PresentationCore</AssemblyReference>
      <AssemblyReference>PresentationFramework</AssemblyReference>
      <AssemblyReference>WindowsBase</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>UiPath.UiAutomation.Activities</AssemblyReference>
      <AssemblyReference>UiPath.Excel.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="Display Results">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="msgFlight" />
      <Variable x:TypeArguments="x:String" Name="msgTrain" />
      <Variable x:TypeArguments="x:String" Name="msgOverall" />
      <Variable x:TypeArguments="x:String" Name="dummy" />
    </Sequence.Variables>
    <Assign DisplayName="Build Flight Message">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[msgFlight]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[in_Source + " to " + in_Destination + "   (" + in_RunMode + " sample data)" + Environment.NewLine + Environment.NewLine + If(in_FlightFound AndAlso in_FlightRow IsNot Nothing, "Airline : " + in_FlightRow("Airline").ToString + " (" + in_FlightRow("FlightNumber").ToString + ")" + Environment.NewLine + "Time : " + in_FlightRow("DepartureTime").ToString + " to " + in_FlightRow("ArrivalTime").ToString + " (" + in_FlightRow("Duration").ToString + ")" + Environment.NewLine + "Fare : Rs. " + in_FlightRow("Fare").ToString, "No valid flight was found for this journey.")]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:InputDialog DisplayName="Show Cheapest Flight" Title="OUTPUT 1 of 3 : Cheapest Flight">
      <ui:InputDialog.Label>
        <InArgument x:TypeArguments="x:String">[msgFlight]</InArgument>
      </ui:InputDialog.Label>
      <ui:InputDialog.Result>
        <OutArgument x:TypeArguments="x:String">[dummy]</OutArgument>
      </ui:InputDialog.Result>
    </ui:InputDialog>
    <Assign DisplayName="Build Train Message">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[msgTrain]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[in_Source + " to " + in_Destination + "   (" + in_RunMode + " sample data)" + Environment.NewLine + Environment.NewLine + If(in_TrainFound AndAlso in_TrainRow IsNot Nothing, "Train : " + in_TrainRow("TrainName").ToString + " (" + in_TrainRow("TrainNumber").ToString + ")" + Environment.NewLine + "Time : " + in_TrainRow("DepartureTime").ToString + " to " + in_TrainRow("ArrivalTime").ToString + " (" + in_TrainRow("Duration").ToString + ")" + Environment.NewLine + "Fare : Rs. " + in_TrainRow("Fare").ToString, "No valid train was found for this journey.")]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:InputDialog DisplayName="Show Cheapest Train" Title="OUTPUT 2 of 3 : Cheapest Train">
      <ui:InputDialog.Label>
        <InArgument x:TypeArguments="x:String">[msgTrain]</InArgument>
      </ui:InputDialog.Label>
      <ui:InputDialog.Result>
        <OutArgument x:TypeArguments="x:String">[dummy]</OutArgument>
      </ui:InputDialog.Result>
    </ui:InputDialog>
    <Assign DisplayName="Build Overall Message">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[msgOverall]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[If(in_CheaperMode &lt;&gt; "None", "Cheaper mode : " + in_CheaperMode + Environment.NewLine + "Service : " + in_CheaperService + Environment.NewLine + "Fare : Rs. " + in_CheaperFare.ToString + Environment.NewLine + "Saves Rs. " + in_PriceDifference.ToString + " vs the other option", in_ComparisonMessage)]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:InputDialog DisplayName="Show Cheapest Overall" Title="OUTPUT 3 of 3 : Cheapest Overall">
      <ui:InputDialog.Label>
        <InArgument x:TypeArguments="x:String">[msgOverall]</InArgument>
      </ui:InputDialog.Label>
      <ui:InputDialog.Result>
        <OutArgument x:TypeArguments="x:String">[dummy]</OutArgument>
      </ui:InputDialog.Result>
    </ui:InputDialog>
  </Sequence>
</Activity>
