  <Sequence DisplayName="Find Cheapest Train">
    <Assign DisplayName="Find Cheapest Train Row">
      <Assign.To>
        <OutArgument x:TypeArguments="sd:DataRow">[out_Row]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="sd:DataRow">[in_TrainsTable.Select().Where(Function(r) IsNumeric(r("Fare").ToString.Trim) AndAlso CDbl(r("Fare").ToString.Trim) &gt; 0).OrderBy(Function(r) CDbl(r("Fare").ToString.Trim)).FirstOrDefault()]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Set Found Flag">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Boolean">[out_Found]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Boolean">[out_Row IsNot Nothing]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Set Cheapest Fare">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Double">[out_Fare]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Double">[If(out_Row IsNot Nothing, CDbl(out_Row("Fare").ToString.Trim), 0.0)]</InArgument>
      </Assign.Value>
    </Assign>
  </Sequence>
</Activity>
