<Activity mc:Ignorable="sap sap2010" x:Class="ExtractFlightData" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation" xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib" xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib" xmlns:sd="clr-namespace:System.Data;assembly=System.Data.Common" xmlns:ui="http://schemas.uipath.com/workflow/activities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_RunMode" Type="InArgument(x:String)" />
    <x:Property Name="in_Source" Type="InArgument(x:String)" />
    <x:Property Name="in_Destination" Type="InArgument(x:String)" />
    <x:Property Name="in_TravelDate" Type="InArgument(x:String)" />
    <x:Property Name="in_DemoFilePath" Type="InArgument(x:String)" />
    <x:Property Name="in_LiveSiteUrl" Type="InArgument(x:String)" />
    <x:Property Name="out_FlightsTable" Type="OutArgument(sd:DataTable)" />
  </x:Members>
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System.Activities</x:String>
      <x:String>System.Activities.Statements</x:String>
      <x:String>System.Activities.Expressions</x:String>
      <x:String>System.Activities.Validation</x:String>
      <x:String>System.Activities.XamlIntegration</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
      <x:String>Microsoft.VisualBasic.Activities</x:String>
      <x:String>System</x:String>
      <x:String>System.Collections</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Data</x:String>
      <x:String>System.Linq</x:String>
      <x:String>System.Xml</x:String>
      <x:String>System.Text</x:String>
      <x:String>System.Xml.Linq</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
      <x:String>System.Collections.ObjectModel</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>mscorlib</AssemblyReference>
      <AssemblyReference>System.Private.CoreLib</AssemblyReference>
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>System.Data</AssemblyReference>
      <AssemblyReference>System.Data.Common</AssemblyReference>
      <AssemblyReference>System.Xml</AssemblyReference>
      <AssemblyReference>System.Xml.Linq</AssemblyReference>
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>Microsoft.CSharp</AssemblyReference>
      <AssemblyReference>PresentationCore</AssemblyReference>
      <AssemblyReference>PresentationFramework</AssemblyReference>
      <AssemblyReference>WindowsBase</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>UiPath.UiAutomation.Activities</AssemblyReference>
      <AssemblyReference>UiPath.Excel.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="Extract Data">
    <Sequence.Variables>
      <Variable x:TypeArguments="sd:DataColumn" Name="tmpCol" />
      <Variable x:TypeArguments="sd:DataRow" Name="tmpRow" />
    </Sequence.Variables>
    <If DisplayName="Live Mode?">
      <If.Condition>
        <InArgument x:TypeArguments="x:Boolean">[in_RunMode = "Live"]</InArgument>
      </If.Condition>
      <If.Then>
        <ui:InvokeWorkflowFile DisplayName="Invoke SearchFlights (Live)" WorkflowFileName="Workflows\SearchFlights.xaml">
          <ui:InvokeWorkflowFile.Arguments>
            <scg:Dictionary x:TypeArguments="x:String, Argument">
              <InArgument x:TypeArguments="x:String" x:Key="in_Source">[in_Source]</InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_Destination">[in_Destination]</InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_TravelDate">[in_TravelDate]</InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_LiveSiteUrl">[in_LiveSiteUrl]</InArgument>
              <OutArgument x:TypeArguments="sd:DataTable" x:Key="out_FlightsTable">[out_FlightsTable]</OutArgument>
            </scg:Dictionary>
          </ui:InvokeWorkflowFile.Arguments>
        </ui:InvokeWorkflowFile>
      </If.Then>
    </If>
    <If DisplayName="Need Demo Data?">
      <If.Condition>
        <InArgument x:TypeArguments="x:Boolean">[out_FlightsTable Is Nothing OrElse out_FlightsTable.Rows.Count = 0]</InArgument>
      </If.Condition>
      <If.Then>
        <Sequence DisplayName="Build Demo Data (in-memory sample)">
          <Assign DisplayName="New Table">
            <Assign.To>
              <OutArgument x:TypeArguments="sd:DataTable">[out_FlightsTable]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="sd:DataTable">[New System.Data.DataTable()]</InArgument>
            </Assign.Value>
          </Assign>
          <Assign DisplayName="Column Airline">
            <Assign.To>
              <OutArgument x:TypeArguments="sd:DataColumn">[tmpCol]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="sd:DataColumn">[out_FlightsTable.Columns.Add("Airline")]</InArgument>
            </Assign.Value>
          </Assign>
          <Assign DisplayName="Column FlightNumber">
            <Assign.To>
              <OutArgument x:TypeArguments="sd:DataColumn">[tmpCol]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="sd:DataColumn">[out_FlightsTable.Columns.Add("FlightNumber")]</InArgument>
            </Assign.Value>
          </Assign>
          <Assign DisplayName="Column DepartureTime">
            <Assign.To>
              <OutArgument x:TypeArguments="sd:DataColumn">[tmpCol]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="sd:DataColumn">[out_FlightsTable.Columns.Add("DepartureTime")]</InArgument>
            </Assign.Value>
          </Assign>
          <Assign DisplayName="Column ArrivalTime">
            <Assign.To>
              <OutArgument x:TypeArguments="sd:DataColumn">[tmpCol]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="sd:DataColumn">[out_FlightsTable.Columns.Add("ArrivalTime")]</InArgument>
            </Assign.Value>
          </Assign>
          <Assign DisplayName="Column Duration">
            <Assign.To>
              <OutArgument x:TypeArguments="sd:DataColumn">[tmpCol]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="sd:DataColumn">[out_FlightsTable.Columns.Add("Duration")]</InArgument>
            </Assign.Value>
          </Assign>
          <Assign DisplayName="Column Fare">
            <Assign.To>
              <OutArgument x:TypeArguments="sd:DataColumn">[tmpCol]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="sd:DataColumn">[out_FlightsTable.Columns.Add("Fare")]</InArgument>
            </Assign.Value>
          </Assign>
          <Assign DisplayName="Row IndiGo">
            <Assign.To>
              <OutArgument x:TypeArguments="sd:DataRow">[tmpRow]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="sd:DataRow">[out_FlightsTable.Rows.Add("IndiGo", "6E-2043", "06:10", "08:55", "2h 45m", "4899")]</InArgument>
            </Assign.Value>
          </Assign>
          <Assign DisplayName="Row Air India">
            <Assign.To>
              <OutArgument x:TypeArguments="sd:DataRow">[tmpRow]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="sd:DataRow">[out_FlightsTable.Rows.Add("Air India", "AI-539", "09:30", "12:20", "2h 50m", "5650")]</InArgument>
            </Assign.Value>
          </Assign>
          <Assign DisplayName="Row Vistara">
            <Assign.To>
              <OutArgument x:TypeArguments="sd:DataRow">[tmpRow]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="sd:DataRow">[out_FlightsTable.Rows.Add("Vistara", "UK-822", "13:05", "15:55", "2h 50m", "6120")]</InArgument>
            </Assign.Value>
          </Assign>
          <Assign DisplayName="Row SpiceJet">
            <Assign.To>
              <OutArgument x:TypeArguments="sd:DataRow">[tmpRow]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="sd:DataRow">[out_FlightsTable.Rows.Add("SpiceJet", "SG-401", "18:40", "21:35", "2h 55m", "4499")]</InArgument>
            </Assign.Value>
          </Assign>
          <Assign DisplayName="Row Akasa Air">
            <Assign.To>
              <OutArgument x:TypeArguments="sd:DataRow">[tmpRow]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="sd:DataRow">[out_FlightsTable.Rows.Add("Akasa Air", "QP-1371", "21:15", "00:05", "2h 50m", "5210")]</InArgument>
            </Assign.Value>
          </Assign>
        </Sequence>
      </If.Then>
    </If>
  </Sequence>
</Activity>
