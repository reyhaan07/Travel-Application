    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="Search Flights (LIVE)">
    <ui:LogMessage DisplayName="Log Live Start" Level="Info">
      <ui:LogMessage.Message>
        <InArgument x:TypeArguments="x:String">["LIVE MODE: opening travel site to search flights from " + in_Source + " to " + in_Destination + " on " + in_TravelDate]</InArgument>
      </ui:LogMessage.Message>
    </ui:LogMessage>
    <ui:OpenBrowser BrowserType="Chrome" DisplayName="Open Demo Travel Site" Url="[in_LiveSiteUrl]">
      <ui:OpenBrowser.Body>
        <ActivityAction x:TypeArguments="ui:Browser">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="ui:Browser" Name="ContextBrowser" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Fill Form And Search">
            <ui:TypeInto Activate="True" ClickBeforeTyping="True" DisplayName="Type Source" EmptyField="True" Text="[in_Source]">
              <ui:TypeInto.Target>
                <ui:Target Selector="&lt;webctrl id='source' tag='INPUT' /&gt;" WaitForReady="INTERACTIVE" />
              </ui:TypeInto.Target>
            </ui:TypeInto>
            <ui:TypeInto Activate="True" ClickBeforeTyping="True" DisplayName="Type Destination" EmptyField="True" Text="[in_Destination]">
              <ui:TypeInto.Target>
                <ui:Target Selector="&lt;webctrl id='destination' tag='INPUT' /&gt;" WaitForReady="INTERACTIVE" />
              </ui:TypeInto.Target>
            </ui:TypeInto>
            <ui:TypeInto Activate="True" ClickBeforeTyping="True" DisplayName="Type Travel Date" EmptyField="True" Text="[in_TravelDate]">
              <ui:TypeInto.Target>
                <ui:Target Selector="&lt;webctrl id='travelDate' tag='INPUT' /&gt;" WaitForReady="INTERACTIVE" />
              </ui:TypeInto.Target>
            </ui:TypeInto>
            <ui:Click ClickType="CLICK_SINGLE" DisplayName="Click Search Fares" MouseButton="BTN_LEFT">
              <ui:Click.Target>
                <ui:Target Selector="&lt;webctrl id='searchBtn' tag='BUTTON' /&gt;" WaitForReady="INTERACTIVE" />
              </ui:Click.Target>
            </ui:Click>
            <ui:LogMessage DisplayName="Log Extraction Note" Level="Warn">
              <ui:LogMessage.Message>
                <InArgument x:TypeArguments="x:String">["LIVE flight extraction step is not wired yet. In UiPath Studio, add an 'Extract Table Data' (Data Scraping) activity here targeting the results table (HTML id='flightsTable') and assign its output to out_FlightsTable. Leaving it empty now so the caller safely uses DEMO data."]</InArgument>
              </ui:LogMessage.Message>
            </ui:LogMessage>
          </Sequence>
        </ActivityAction>
      </ui:OpenBrowser.Body>
    </ui:OpenBrowser>
  </Sequence>
</Activity>
